# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
# Can be named VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Application URL (for email links)
VITE_APP_URL=http://localhost:5173

# Resend API Key (Optional for local dev, used by /api/send-report)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Interview Feedback <onboarding@resend.dev>

# Google Analytics 4 (Measurement ID from Web Data Stream: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Stripe Tip / Platform Support Checkout URL
VITE_STRIPE_TIP_URL=https://buy.stripe.com/cNi6oG6Wb5tlgNpfg93ks01

